# Copy to .env and fill in before running database commands.
# Never commit .env or real credentials.

# Neon Postgres (https://console.neon.tech -> project -> Connect -> Prisma).
# Use the POOLED connection string (contains "-pooler") for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: direct (non-pooled) URL for migrations if you add `directUrl` later.
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Optional sprint/demo controls
# Mock external integrations (email / Accelevents / Airtable) as logged no-ops.
MOCK_EXTERNAL_APIS=true

# Destructive demo reset gate. Must be "true" for the reset endpoint
# (POST /api/admin/reset, admin-only) or reset script to run. Leave unset/
# "false" in production so the reset is refused.
ALLOW_DEMO_RESET=false

# Passwordless one-click /login personas. Only consulted when NODE_ENV is
# "production", where they are refused unless this is exactly "true" — so a
# production deployment that omits it fails closed. Local development, tests and
# the smoke harnesses keep the personas on with no flag, so leave this unset
# unless you are configuring a production deployment that should offer them.
# DEMO_PERSONA_LOGIN_ENABLED=true

# Public base URL of the deployment (absolute links in emails and .ics files).
# APP_URL=https://your-app.vercel.app

# Optional real-integration credentials. When absent, the mock path is used.
# RESEND_API_KEY=re_xxx
# Required with RESEND_API_KEY when MOCK_EXTERNAL_APIS=false. Use a verified
# Resend sender, for example: Greenroom <updates@example.com>
# RESEND_FROM=Greenroom <updates@example.com>
# ACCELEVENTS_BASE_URL=https://integration.example.com/accelevents/program-sync
# ACCELEVENTS_API_KEY=optional_authorization_value
# AIRTABLE_API_KEY=key_xxx
# AIRTABLE_BASE_ID=app_xxx

# Optional read-only v1 REST API. Leave unset to disable the surface (503).
# Keep this server-only and use a random value of at least 32 characters.
# GREENROOM_API_KEY=replace_with_a_random_value_at_least_32_characters

# Required in production for signed auth cookies. Keep server-only and use a
# distinct random value of at least 32 characters. Local development/test has
# a non-production fallback so this may remain unset there.
# SESSION_SECRET=replace_with_a_random_value_at_least_32_characters
