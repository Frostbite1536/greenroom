generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EVALUATOR
  SPEAKER
}

enum AbstractStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MAYBE
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
}

enum EvaluationAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/** Last audited provider result for one reviewer-invite token version. */
enum ReviewerInviteDeliveryState {
  PENDING
  SENT
  MOCKED
  FAILED
}

/** Where a speaker is in accepting their invitation to take part. */
enum SpeakerStatus {
  INVITED
  CONFIRMED
  DECLINED
}

/** Whether a Session appears on the public programme. */
enum SessionContentStatus {
  DRAFT
  PUBLISHED
}

/**
 * What an uploaded file is for. The kind — not the request — decides the size
 * cap, the accepted MIME set, and who may read the bytes back
 * (`lib/uploads/stored-file.ts`).
 */
enum StoredFileKind {
  HEADSHOT
  SLIDE_DECK
  /// A speaker's supporting document on one of their own proposals. Private
  /// under exactly the SLIDE_DECK rule: the uploader, or an ADMIN whose active
  /// event is the event the file was uploaded under. Added as an enum VALUE so
  /// the change stays additive (M4 precedent) — no column is modified.
  SUPPORTING_DOCUMENT
  /// A speaker's deliverable for one of their own onboarding tasks, recorded in
  /// `SpeakerTask.artifactUrl` as this app's own `/api/files/<id>` path. Private
  /// under exactly the SLIDE_DECK rule: the uploader, or an ADMIN whose active
  /// event is the event the file was uploaded under. Added as an enum VALUE so
  /// the change stays additive (M4 precedent) — no column is modified.
  TASK_ARTIFACT
}

model Event {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  timezone  String    @default("UTC")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships     EventMember[]
  forms           FormConfig[]
  categories      Category[]
  abstracts       Abstract[]
  sessions        Session[]
  evaluationPlans EvaluationPlan[]
  tracks          Track[]
  rooms           Room[]
  scheduleSlots   ScheduleSlot[]
  onboardingTasks OnboardingTask[]
  resources       ResourceWiki[]
  emailTemplates  EmailTemplate[]
  imports         ImportJob[]
  publicSubmissionRateBuckets PublicSubmissionRateBucket[]
  reviewerInvites             ReviewerInvite[]
  storedFiles                 StoredFile[]
  apiCredentials              ApiCredential[]
  speakerDecks                EventSpeakerDeck[]

  @@index([startsAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  /// Versioned scrypt credential (`lib/password-credential.ts`), or null for the
  /// one-click demo personas and every provisioned user without a password.
  /// Never projected by any serializer; never logged.
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        EventMember[]
  speakerProfile     SpeakerProfile?
  submittedAbstracts Abstract[]         @relation("AbstractSubmitter")
  abstractSpeakers   AbstractSpeaker[]
  sessionSpeakers    SessionSpeaker[]
  reviewAssignments  ReviewAssignment[]
  reviewScores       ReviewScore[]
  taskAssignments    SpeakerTask[]
  sentEmails         EmailDispatch[]    @relation("EmailSender")
  reviewerInvites    ReviewerInvite[]
  storedFiles        StoredFile[]
  apiCredentials     ApiCredential[]
  abstractAttachments AbstractAttachment[]
  eventSpeakerDecks   EventSpeakerDeck[]
}

model EventMember {
  eventId   String
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId, role])
}

/**
 * Renewable event-scoped reviewer access. The bearer nonce is signed but never
 * stored: only its version and expiry remain after a token rotates.
 */
model ReviewerInvite {
  id                String                      @id @default(cuid())
  eventId           String
  userId            String
  tokenVersion      Int                         @default(1)
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedVersion   Int?
  lastSentAt        DateTime?
  sendWindowStart   DateTime?
  sendWindowCount   Int                         @default(0)
  lastDeliveryState ReviewerInviteDeliveryState @default(PENDING)
  lastDeliveryAt    DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, expiresAt])
  @@index([eventId, sendWindowStart])
  @@index([expiresAt])
}

model SpeakerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  // Where this person is in accepting their invitation. CONFIRMED by default
  // because every speaker on an existing programme is already live and taking
  // part: any other default would mark a whole roster as unconfirmed the moment
  // this column is applied.
  status       SpeakerStatus @default(CONFIRMED)
  bio          String?
  company      String?
  jobTitle     String?
  headshotUrl  String?
  slideDeckUrl String?
  socialLinks  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  description    String?
  defaultTeamKey String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  abstracts Abstract[]
  sessions  Session[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model FormConfig {
  id              String    @id @default(cuid())
  eventId         String
  name            String
  slug            String
  welcomeText     String?
  thankYouText    String?
  opensAt         DateTime?
  closesAt        DateTime?
  submissionLimit Int?
  minSpeakers     Int       @default(1)
  maxSpeakers     Int       @default(1)
  maxBioLength    Int       @default(1000)
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields    FormField[]
  abstracts Abstract[]
  tasks     OnboardingTask[] @relation("TaskForm")

  @@unique([eventId, slug])
  @@index([eventId, published])
}

model FormField {
  id               String        @id @default(cuid())
  formConfigId     String
  key              String
  label            String
  helpText         String?
  type             FormFieldType
  required         Boolean       @default(false)
  options          Json?
  conditionalLogic Json?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  formConfig FormConfig   @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  answers    FormAnswer[]

  @@unique([formConfigId, key])
  @@index([formConfigId, sortOrder])
}

model Abstract {
  id              String         @id @default(cuid())
  eventId         String
  formConfigId    String
  submitterId     String
  title           String
  abstract        String?
  format          String?
  durationMinutes Int?
  categoryId      String?
  status          AbstractStatus @default(DRAFT)
  draftCapabilityHash String?
  draftRevision   Int            @default(0)
  submittedAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formConfig        FormConfig         @relation(fields: [formConfigId], references: [id], onDelete: Restrict)
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  submitter         User               @relation("AbstractSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  speakers          AbstractSpeaker[]
  answers           FormAnswer[]
  reviewAssignments ReviewAssignment[]
  reviewScores      ReviewScore[]
  session           Session?
  attachments       AbstractAttachment[]

  @@index([eventId, status])
  @@index([formConfigId, status])
  @@index([categoryId])
  @@index([submitterId])
}

model AbstractSpeaker {
  abstractId String
  userId     String
  isPrimary  Boolean @default(false)
  // How this person contributes to this proposal ("Co-presenter", "Panellist").
  // Per-proposal, not per-person: the same speaker can hold different roles on
  // different talks, which is why it lives here and not on SpeakerProfile.
  role       String?

  abstract Abstract @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([abstractId, userId])
  @@index([userId])
}

model FormAnswer {
  id          String   @id @default(cuid())
  abstractId  String
  formFieldId String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  abstract  Abstract  @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  formField FormField @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@unique([abstractId, formFieldId])
  @@index([formFieldId])
}

/** Durable, HMAC-fingerprinted public CFP write throttles. */
model PublicSubmissionRateBucket {
  id          String   @id @default(cuid())
  eventId     String
  scope       String
  fingerprint String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, scope, fingerprint, windowStart])
  @@index([expiresAt])
  @@index([eventId, scope, windowStart])
}

model EvaluationPlan {
  id        String    @id @default(cuid())
  eventId   String
  name      String
  ordinal   Int
  isBlind   Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  rubric    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments ReviewAssignment[]
  scores      ReviewScore[]

  @@unique([eventId, ordinal])
}

model ReviewAssignment {
  id          String                     @id @default(cuid())
  planId      String
  abstractId  String
  evaluatorId String
  teamKey     String?
  status      EvaluationAssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime                   @default(now())
  completedAt DateTime?

  plan      EvaluationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  abstract  Abstract       @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  evaluator User           @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([planId, abstractId, evaluatorId])
  @@index([evaluatorId, status])
  @@index([abstractId, planId])
  @@index([planId, teamKey])
}

model ReviewScore {
  id          String   @id @default(cuid())
  planId      String
  abstractId  String
  evaluatorId String
  rubricKey   String
  score       Decimal  @db.Decimal(5, 2)
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan      EvaluationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  abstract  Abstract       @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  evaluator User           @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([planId, abstractId, evaluatorId, rubricKey])
  @@index([abstractId, planId])
}

model Session {
  id               String   @id @default(cuid())
  eventId          String
  sourceAbstractId String?  @unique
  title            String
  description      String?
  format           String?
  durationMinutes  Int
  // Whether this talk is part of the published programme. PUBLISHED is the
  // default because every scheduled session is publicly visible today: any
  // other default would hide a live programme the moment this column is
  // applied. Unpublishing is therefore an explicit organizer act.
  contentStatus    SessionContentStatus @default(PUBLISHED)
  // The topic the proposal was submitted under, carried onto the talk when the
  // abstract is accepted. Nullable because a Session may be authored directly
  // (a keynote), and SetNull because deleting a Category must never delete a
  // confirmed talk — it only takes its label away.
  categoryId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceAbstract Abstract?        @relation(fields: [sourceAbstractId], references: [id], onDelete: SetNull)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  speakers       SessionSpeaker[]
  scheduleSlot   ScheduleSlot?

  @@index([eventId])
  @@index([categoryId])
}

model SessionSpeaker {
  sessionId String
  userId    String
  isPrimary Boolean @default(false)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
}

model Track {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots ScheduleSlot[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model Room {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  capacity  Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots ScheduleSlot[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model ScheduleSlot {
  id        String   @id @default(cuid())
  eventId   String
  sessionId String   @unique
  roomId    String
  trackId   String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([eventId, startsAt, endsAt])
  @@index([roomId, startsAt, endsAt])
}

model OnboardingTask {
  id           String    @id @default(cuid())
  eventId      String
  title        String
  description  String?
  dueAt        DateTime?
  required     Boolean   @default(true)
  formConfigId String? // optional form the speaker fills to complete this task
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formConfig  FormConfig?   @relation("TaskForm", fields: [formConfigId], references: [id], onDelete: SetNull)
  assignments SpeakerTask[]

  @@unique([eventId, title])
  @@index([eventId, sortOrder])
}

model SpeakerTask {
  taskId      String
  userId      String
  status      TaskStatus @default(TODO)
  artifactUrl String?
  responses   Json? // answers when the task carries a form
  notes       String?
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt

  task OnboardingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, status])
}

model ResourceWiki {
  id          String   @id @default(cuid())
  eventId     String
  slug        String
  title       String
  summary     String?
  htmlContent String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
  @@index([eventId, published])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  eventId   String
  key       String
  subject   String
  htmlBody  String
  trigger   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dispatches EmailDispatch[]

  @@unique([eventId, key])
}

model EmailDispatch {
  id         String    @id @default(cuid())
  templateId String
  senderId   String?
  recipient  String
  variables  Json?
  status     String    @default("queued")
  providerId String?
  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sender   User?         @relation("EmailSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/**
 * A file the product actually holds, rather than a link it hopes stays up.
 *
 * The bytes live in Postgres on purpose: the alternative was a new external
 * blob credential on deadline night, and these bounded uploads are small,
 * rarely read, and already inside the transactional backup of everything else
 * it belongs to. `mime` is only ever a value this server itself derived from
 * the magic bytes, never the string a client claimed — the serving route sets
 * `Content-Type` from this column, so a client-chosen value here would be a
 * stored-XSS primitive.
 *
 * `eventId` is the event the upload happened under. It is a scoping and
 * cleanup fact, not an authorization one for headshots (they render on public
 * speaker surfaces); for both private kinds it is half of the organizer's read claim.
 * SetNull because deleting an event must never delete a person's own headshot.
 *
 * `@@unique([uploaderUserId, kind, sha256])` is the dedupe key. For a public
 * headshot, `sha256` is the raw content digest and re-uploading across events
 * returns the same row. For a private slide deck or supporting document it is a versioned,
 * event-scoped SHA-256 fingerprint over the event id and raw content digest,
 * so matching bytes cannot inherit another event's organizer authorization.
 * Its leftmost column is the per-uploader index — a separate
 * `@@index([uploaderUserId])` would be an exact prefix duplicate of it.
 */
model StoredFile {
  id             String         @id @default(cuid())
  uploaderUserId String
  eventId        String?
  kind           StoredFileKind
  /// Server-derived content type. Never the client's claimed value.
  mime           String
  size           Int
  /// Raw content SHA for headshots; event-scoped fingerprint for private files.
  sha256         String
  bytes          Bytes
  createdAt      DateTime       @default(now())

  uploader User   @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  event    Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Inverse relation metadata only — no column is added to this table.
  attachments AbstractAttachment[]

  @@unique([uploaderUserId, kind, sha256])
  @@index([eventId])
}

/**
 * One supporting document linked to one proposal.
 *
 * A JOIN ROW rather than an `abstractId` column on `StoredFile`, because
 * `StoredFile` is deduplicated on `@@unique([uploaderUserId, kind, sha256])`:
 * the same speaker attaching the same PDF to two of their proposals gets ONE
 * stored row back from `POST /api/files`, and a single owning column could then
 * only ever point at whichever proposal claimed it first. The link is also what
 * the per-proposal cap counts, and what "remove this attachment" deletes.
 *
 * Deliberate delete behaviour:
 * - Deleting the proposal cascades the links away (the bytes are not this
 *   table's to destroy).
 * - Deleting the `StoredFile` cascades its links away.
 * - Removing an attachment deletes ONLY this row. The bytes stay, exactly as
 *   clearing `slideDeckUrl` has always left an uploaded deck in place: the same
 *   row may be attached to another proposal and is still the dedupe target for
 *   the uploader's next identical upload.
 */
model AbstractAttachment {
  id           String   @id @default(cuid())
  abstractId   String
  storedFileId String
  /// Who attached it. The only person who may remove it, and — with the event's
  /// admins — the only person who may read the bytes back.
  uploadedById String
  /// The speaker's own file name, for display. Never a path, never trusted as one.
  filename     String
  createdAt    DateTime @default(now())

  abstract   Abstract   @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([abstractId, storedFileId])
  @@index([abstractId])
  @@index([storedFileId])
  @@index([uploadedById])
}

/**
 * One speaker's slide deck FOR ONE EVENT (roadmap "Scoped credentials" item:
 * "one global profile URL cannot provide per-event-private deck access").
 *
 * `SpeakerProfile.slideDeckUrl` is global — one row per person for the whole
 * instance — so it cannot hold a different deck per event and cannot be private
 * to one event's organizers. This table holds the per-event value; the global
 * column is untouched and remains the fallback for events with no row here.
 *
 * A URL column rather than a `storedFileId` FK on purpose: the product's deck
 * field has always accepted EITHER an uploaded `/api/files/<id>` path OR a
 * pasted absolute link, validated by one schema (`nullableProfileUrl`). An FK
 * could not represent the pasted link, so it would either drop that capability
 * or need both columns to say one thing.
 */
model EventSpeakerDeck {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  /// Same accepted shapes as `SpeakerProfile.slideDeckUrl`: an absolute URL, or
  /// this app's own `/api/files/<id>` path. Validated by `nullableProfileUrl`.
  deckUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model ImportJob {
  id           String       @id @default(cuid())
  eventId      String
  source       String
  status       ImportStatus @default(PENDING)
  fieldMapping Json
  summary      Json?
  error        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
}

/**
 * A revocable, event-scoped credential for the read-only v1 API
 * (docs/ROADMAP.md, "Scoped credentials").
 *
 * The issued token is `grk_<lookupId>_<secret>` and exists in plaintext exactly
 * once, in the body of the response that creates it. The two halves are stored
 * differently on purpose:
 *
 *   - `lookupId` is NOT a secret. It is stored in plaintext, uniquely indexed,
 *     and shown to the organizer as the credential's visible name. It is what
 *     authentication looks a row up by, which is what makes verification a
 *     single indexed point read rather than a scan over the event's keys — and
 *     it means no index here is keyed on anything derived from the secret.
 *   - `secretHash` is the SHA-256 hex digest of the secret half, and the only
 *     stored form of it. This table can therefore be read end to end without
 *     recovering a single working credential (INV-SECRET-001).
 *
 * There is no stored display prefix: the visible form is `grk_` plus
 * `lookupId`, derived where it is shown. A stored copy of a pure function of
 * another column is a second source of truth with nothing keeping it in step.
 *
 * `revokedAt` is a tombstone, not a delete: a credential that was used against
 * this event must stay auditable after it stops working, and keeping the row
 * keeps its `lookupId` permanently claimed, so a revoked identifier can never
 * be handed out again by chance.
 *
 * There is deliberately no `lastUsedAt`. Every authenticated v1 read is a
 * SELECT; stamping a timestamp would turn the whole read surface into a writer,
 * adding a row update and its WAL traffic to a path whose entire purpose is
 * cheap mirroring. Usage telemetry, if it is ever wanted, belongs in an
 * append-only log, not in the authenticator's own row.
 *
 * Delete behaviour is chosen, not defaulted:
 *   - `event`     Cascade. The credential authorizes reads of exactly one
 *                 event. When that event is gone the credential authorizes
 *                 nothing, and leaving live secret material behind pointing at
 *                 a dead scope is strictly worse than removing it. This is also
 *                 the prevailing convention for every event-owned row here.
 *   - `createdBy` SetNull, and the column is nullable. The credential belongs
 *                 to the event, not to the person who happened to press the
 *                 button: an organizer leaving the team must not silently break
 *                 a working integration, and must not be able to erase the
 *                 record of what they issued either. Same reasoning, and the
 *                 same convention, as `EmailDispatch.sender`.
 */
model ApiCredential {
  id              String    @id @default(cuid())
  eventId         String
  /// Operator-supplied display name. Bounded at the request boundary.
  label           String
  /// Non-secret public identifier: the indexed lookup key, and the shown value.
  lookupId        String    @unique
  /// SHA-256 hex digest of the secret half. Never projected, never logged.
  secretHash      String
  createdByUserId String?
  createdAt       DateTime  @default(now())
  /// Set once, never cleared: revocation is permanent for this credential.
  revokedAt       DateTime?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
}
